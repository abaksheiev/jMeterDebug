        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load: WeatherResponse.groovy">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def dir_base_tests = vars.get(&quot;dir_base_tests&quot;)
def dir_base_scripts = vars.get(&quot;dir_base_scripts&quot;)

if (!dir_base_tests || !dir_base_scripts) {
    log.error(&quot;❌ Missing base directory variables!&quot;)
    return
}

def classLoader = new GroovyClassLoader()

// ✅ Загружаем WeatherResponse
File modelFile = new File(dir_base_scripts + &quot;scripts/WeatherResponse.groovy&quot;)  // Путь с учетом пакета
if (!modelFile.exists()) {
    log.error(&quot;❌ WeatherResponse.groovy not found: ${modelFile.absolutePath}&quot;)
    return
}
Class weatherResponseClass = classLoader.parseClass(modelFile)
vars.putObject(&quot;WeatherResponse&quot;, weatherResponseClass)
log.info(&quot;✅ WeatherResponse.groovy loaded&quot;)

// ✅ Загружаем WeatherResponseSpec
File testFile = new File(dir_base_tests + &quot;tests/WeatherResponseSpec.groovy&quot;)  // Путь с учетом пакета
if (!testFile.exists()) {
    log.error(&quot;❌ WeatherResponseSpec.groovy not found: ${testFile.absolutePath}&quot;)
    return
    }
Class weatherResponseSpecClass = classLoader.parseClass(testFile)
vars.putObject(&quot;WeatherResponseSpec&quot;, weatherResponseSpecClass)
log.info(&quot;✅ weatherResponseSpec.groovy loaded&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load: WeatherResponseSpecClass.groovy" enabled="false">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def dir_base_tests = vars.get(&quot;dir_base_tests&quot;)

if (dir_base_tests == null) {
    log.error(&quot;❌ dir_base_tests is null! Did you set the variable?&quot;)
} else {
    def classLoader = new GroovyClassLoader()
    File file = new File(dir_base_tests + &quot;WeatherResponseSpec.groovy&quot;)

    if (!file.exists()) {
        log.error(&quot;❌ File not found: ${file.getAbsolutePath()}&quot;)
    } else {
        Class weatherClass = classLoader.parseClass(file)
        vars.putObject(&quot;WeatherResponseSpec&quot;, weatherClass)
        log.info(&quot;----✅ WeatherResponseSpecClass class loaded and stored.&quot;)
    }
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP: /v1/forecast">
          <stringProp name="HTTPSampler.domain">api.open-meteo.com</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/v1/forecast?latitude=52.52&amp;longitude=13.41&amp;current_weather=true</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Parth and Validate json response">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def response = prev.getResponseDataAsString()

// Retrieve the previously stored class
def weatherClass = vars.getObject(&quot;WeatherResponse&quot;)
def result = weatherClass.fromJson(response)

vars.putObject(&quot;WeatherResponseObj&quot;, result)


</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validation Response">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Retrieve the previously stored class

def weatherTestClass = vars.getObject(&quot;WeatherResponseSpec&quot;)
def responseObj = vars.getObject(&quot;WeatherResponseObj&quot;)

weatherTestClass.validate(responseObj)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
